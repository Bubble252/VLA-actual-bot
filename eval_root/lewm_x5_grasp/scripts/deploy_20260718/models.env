#!/usr/bin/env bash
# 2026-07-18 三模型 registry（在 start_remote_policy.sh / 本机 client 前 source）
CKPT_ROOT="${CKPT_ROOT:-/vepfs-mlp2/c20250405/400040/transfer/starvla/starVLA/results/Checkpoints}"

# MODEL=1p|2p|3p  （或 eef_libero / eef_scratch / joint）
# 3p 默认已切到 20260721-1616*；旧 7.17 关节用 MODEL=3p_old
MODEL="${MODEL:-3p}"
CKPT_STEP="${CKPT_STEP:-}"   # 空 / latest → 远程自动选最大 steps_*.pt

case "${MODEL}" in
  1p|eef_libero|1)
    RUN_DIR="${CKPT_ROOT}/20260716_1738_arx_x5_libero_arx_x5_full_8gpu"
    DEFAULT_STEP=98000
    MID_STEP=90250
    export UNNORM_KEY="${UNNORM_KEY:-franka}"
    export POLICY_PORT="${POLICY_PORT:-5694}"
    # 实机避开 mode=4：EEF 序列经客户端 IK 转关节后 mode=5
    export ACTION_SPACE=eef_via_joint
    export CONTROL_HZ=20
    export POS_SCALE=0.05
    export ROT_SCALE=0.5
    # 训练数据 arx_x5_*_libero_* 用了 neg_x_z1；部署必须逆变换
    export FRAME_ALIGN="${FRAME_ALIGN:-neg_x_z1}"
    ;;
  2p|eef_scratch|2)
    RUN_DIR="${CKPT_ROOT}/20260717_0518_arx_x5_libero_arx_x5_scratch_8gpu"
    DEFAULT_STEP=7750
    MID_STEP=4000
    export UNNORM_KEY="${UNNORM_KEY:-franka}"
    export POLICY_PORT="${POLICY_PORT:-5695}"
    export ACTION_SPACE=eef_via_joint
    export CONTROL_HZ=20
    export POS_SCALE=0.05
    export ROT_SCALE=0.5
    # 纯 ARX EEF scratch：数据若未做 neg_x_z1，部署不要逆变换
    export FRAME_ALIGN="${FRAME_ALIGN:-none}"
    ;;
  3p|joint|3|new)
    # 2026-07-21 pick_can 关节 scratch（强制覆盖，避免 shell 残留旧 RUN_DIR）
    RUN_DIR="${CKPT_ROOT}/20260721_1630_arx_x5_joint_clean_pick_can_scratch_8gpu_bs96_ep20"
    DEFAULT_STEP=latest
    MID_STEP=1250
    export UNNORM_KEY="${UNNORM_KEY:-new_embodiment}"
    export POLICY_PORT="${POLICY_PORT:-5794}"
    export ACTION_SPACE=joint
    export CONTROL_HZ=30
    export POS_SCALE=1.0
    export ROT_SCALE=1.0
    export FRAME_ALIGN="${FRAME_ALIGN:-none}"
    ;;
  3p_1616|joint_1616)
    RUN_DIR="${CKPT_ROOT}/20260721_1616_arx_x5_joint_clean_arx_x5_joint_clean_resume_from_10000"
    DEFAULT_STEP=latest
    MID_STEP=12500
    export UNNORM_KEY="${UNNORM_KEY:-new_embodiment}"
    export POLICY_PORT="${POLICY_PORT:-5794}"
    export ACTION_SPACE=joint
    export CONTROL_HZ=30
    export POS_SCALE=1.0
    export ROT_SCALE=1.0
    export FRAME_ALIGN="${FRAME_ALIGN:-none}"
    ;;
  3p_old|joint_old)
    RUN_DIR="${CKPT_ROOT}/20260717_1138_arx_x5_joint_clean_arx_x5_joint_clean_scratch_8gpu"
    DEFAULT_STEP=10000
    MID_STEP=5000
    export UNNORM_KEY="${UNNORM_KEY:-new_embodiment}"
    export POLICY_PORT="${POLICY_PORT:-5794}"
    export ACTION_SPACE=joint
    export CONTROL_HZ=30
    export POS_SCALE=1.0
    export ROT_SCALE=1.0
    export FRAME_ALIGN="${FRAME_ALIGN:-none}"
    ;;
  *)
    echo "ERROR: unknown MODEL=${MODEL} (use 1p|2p|3p|3p_old)" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

# Allow full override of run dir / ckpt path from env
if [[ -n "${RUN_DIR_OVERRIDE:-}" ]]; then
  RUN_DIR="${RUN_DIR_OVERRIDE}"
fi

if [[ "${CKPT_STEP}" == "mid" ]]; then
  if [[ -z "${MID_STEP}" ]]; then
    echo "ERROR: MODEL=${MODEL} has no MID_STEP; set CKPT_STEP=<number>" >&2
    return 1 2>/dev/null || exit 1
  fi
  CKPT_STEP="${MID_STEP}"
fi
CKPT_STEP="${CKPT_STEP:-${DEFAULT_STEP}}"

# Placeholder path; start_remote_policy.sh may resolve RUN_DIR glob + latest step on remote
if [[ "${CKPT_STEP}" == "latest" || "${CKPT_STEP}" == "last" ]]; then
  export CKPT_PATH="${RUN_DIR}/checkpoints/steps_LATEST_pytorch_model.pt"
else
  export CKPT_PATH="${RUN_DIR}/checkpoints/steps_${CKPT_STEP}_pytorch_model.pt"
fi
export CKPT_STEP RUN_DIR MID_STEP DEFAULT_STEP

export FRAME_ALIGN="${FRAME_ALIGN:-none}"
echo "[models.env] MODEL=${MODEL} step=${CKPT_STEP} port=${POLICY_PORT} unnorm=${UNNORM_KEY} space=${ACTION_SPACE} hz=${CONTROL_HZ} frame_align=${FRAME_ALIGN}"
echo "[models.env] RUN_DIR=${RUN_DIR}"
echo "[models.env] CKPT_PATH=${CKPT_PATH}"
